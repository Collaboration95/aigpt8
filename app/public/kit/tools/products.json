[
  {
    "type": "function",
    "function": {
      "name": "show_usual",
      "description": "Use when the shopper wants to reorder a known previous purchase. Show its actual order provenance in because; do not invent purchase history.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 30,
            "description": "Short visible heading."
          },
          "product_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Exact ID from the product catalogue."
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^\\s*\\S+(?:\\s+\\S+){0,5}\\s*$",
              "description": "At most six words. Supported reason, aligned with product_ids."
            },
            "maxItems": 8
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 24
            },
            "maxItems": 8,
            "description": "Optional short supported labels aligned with product_ids. Never invent safety claims."
          },
          "highlight_id": {
            "type": "string",
            "description": "ID in product_ids. For alternatives, the current product used for price deltas."
          },
          "because": {
            "type": "string",
            "maxLength": 160,
            "description": "Actual supplied memory provenance. Omit when no memory supports it."
          },
          "variant": {
            "type": "string",
            "enum": [
              "hero",
              "receipt",
              "compact",
              "timeline",
              "gradient",
              "refill"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "mint",
              "grape",
              "sun",
              "ocean",
              "rose",
              "ink"
            ]
          }
        },
        "required": [
          "title",
          "product_ids"
        ]
      },
      "x-examples": [
        {
          "title": "Your usual toothpaste",
          "product_ids": [
            "tp-median"
          ],
          "reasons": [
            "Your saved mint favourite"
          ],
          "because": "From your toothpaste order 6 weeks ago",
          "variant": "compact"
        },
        {
          "title": "Buy it again",
          "product_ids": [
            "tp-median"
          ],
          "badges": [
            "Your usual"
          ],
          "because": "Demo order · 13 Sep 2026",
          "variant": "receipt"
        }
      ]
    }
  },
