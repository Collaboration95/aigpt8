  {
    "type": "function",
    "function": {
      "name": "ask_choice",
      "description": "Use when the shopper must choose ONE direction among several distinct needs, contexts or styles. Prefer a known preselect with a truthful because. Use pick_variant for SKU attributes and ask_a_or_b for exactly two contrasting alternatives.",
