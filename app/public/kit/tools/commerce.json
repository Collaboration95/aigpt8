  {
    "type": "function",
    "function": {
      "name": "subscribe",
      "description": "Use for replenishable purchases when choosing a repeat or reminder cadence. Records a cadence preference only; does not create a paid subscription or claim unverified savings.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Short heading."
          },
          "theme": {
            "type": "string",
            "enum": [
              "mint",
              "grape",
              "sun",
              "ocean",
              "rose",
              "ink"
            ]
          },
          "flow": {
            "type": "string",
            "description": "Flow provenance, e.g. toothpaste or mosquito."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "description": "Exact ID from the product catalogue."
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99,
                  "default": 1
                }
              },
              "required": [
                "product_id"
              ],
              "additionalProperties": false
            }
          },
          "cadence": {
            "type": "integer",
            "enum": [
              2,
              4,
              6,
              8
            ],
            "default": 4
