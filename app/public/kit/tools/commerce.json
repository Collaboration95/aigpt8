  {
    "type": "function",
    "function": {
      "name": "bundle",
      "description": "Use when the shopper needs to evaluate a set of complementary products, select items, or request individual swaps. All prices come from the catalogue.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Short heading."
          },
          "theme": {
            "type": "string",
            "enum": [
              "mint",
              "grape",
              "sun",
              "ocean",
              "rose",
              "ink"
            ]
          },
          "flow": {
            "type": "string",
            "description": "Flow provenance, e.g. toothpaste or mosquito."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "description": "Exact ID from the product catalogue."
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99,
                  "default": 1
                }
              },
              "required": [
                "product_id"
              ],
              "additionalProperties": false
            }
          },
          "variant": {
            "type": "string",
            "enum": [
              "checklist",
              "basket",
              "receipt",
              "flatlay",
              "swipe"
            ],
            "description": "Optional visual treatment; omit to let the bandit choose."
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "x-examples": [
        {
          "title": "Your oral-care kit",
          "items": [
            {
              "product_id": "tp-median",
